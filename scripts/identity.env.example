# Local owner identity: copy to scripts/identity.env (gitignored). build.sh sources it;
# environment variables with the same names win. CI reads repository variables instead
# (docs/RELEASING.md).

# Base bundle id; dev builds append ".dev".
export HEALTHBAR_BUNDLE_ID="${HEALTHBAR_BUNDLE_ID:-com.vladforfutdinov.healthbar}"

# App display name; dev builds append " (dev)".
export HEALTHBAR_DISPLAY_NAME="${HEALTHBAR_DISPLAY_NAME:-HealthBar}"

# GitHub owner/repo (About link, cask URLs).
export HEALTHBAR_REPO_SLUG="${HEALTHBAR_REPO_SLUG:-vladforfutdinov/health-bar}"

# Sparkle appcast URL; empty disables update checks.
export HEALTHBAR_FEED_URL="${HEALTHBAR_FEED_URL:-}"

# Sparkle EdDSA PUBLIC key; pairs with the SPARKLE_ED_PRIVATE_KEY secret.
export HEALTHBAR_SU_PUBLIC_KEY="${HEALTHBAR_SU_PUBLIC_KEY:-}"

# Homebrew tap owner/name (CI only).
export HEALTHBAR_TAP_REPO="${HEALTHBAR_TAP_REPO:-vladforfutdinov/homebrew-healthbar}"
